# ------------------------------------------------------------------
# ClipForge environment variables
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local or share your keys.
# ------------------------------------------------------------------

# --- Database ---
# ClipForge uses SQLite locally (no external DB needed to run).
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate a strong random string:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
APP_URL="http://localhost:3000"
# Where uploaded source videos + rendered clips are stored on disk
MEDIA_STORAGE_DIR="./media"

# --- AI: Transcription (optional, recommended) -----------------------
# If OPENAI_API_KEY is set, the Whisper API is used for real transcription.
# If not set, ClipForge falls back to a built-in demo transcript so the
# whole clipping pipeline still works end-to-end without external keys.
# Leave blank to run fully offline.
OPENAI_API_KEY=""
OPENAI_WHISPER_MODEL="whisper-1"

# --- AI: Highlight analysis (optional) --------------------------------
# Optional key for a second pass summarizer. Leave blank to use the built-in
# engagement-scoring engine (silence-boundary + loudness + keyword analysis),
# which works fully offline with ffmpeg.
# OPENAI_BASE_URL=""

# --- Billing / Stripe --------------------------------------------------
# ClipForge ships with a credit architecture and an admin integration page.
# To go live, create a Stripe account and paste your keys here, then set
# BILLING_PROVIDER=stripe. Until then billing runs in a local "mock" mode
# that lets you test credits end-to-end.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
BILLING_PROVIDER="mock"

# --- Rate limiting (best-effort) --------------------------------------
RATE_LIMIT_ENABLED="true"